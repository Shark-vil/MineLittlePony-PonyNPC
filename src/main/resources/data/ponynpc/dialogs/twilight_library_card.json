    "card_give": {
      "text": "Ты знаком с трудами Старстрик! Отлично. Держи запасной билет.",
      "choices": [
        {
          "id": "thanks_correct",
          "text": "Отличная книга, кстати. Спасибо!",
          "next": null,
          "once": false,
          "conditions": ["quest:shadow_book_ch1:stage:find_twilight"],
          "hidden_if_condition_fails": false,
          "actions": [
            "quest:shadow_book_ch1:give_quest_item:library_card",
