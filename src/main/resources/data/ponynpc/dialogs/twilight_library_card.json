          "once": false
        },
        {
          "id": "wrong_answer",
          "text": "Эм... «Самоучитель по магии»?",
          "next": "card_denied",
          "once": false
        }
      ]
    },
    "card_denied": {
      "text": "Такой книги нет. Извини, но я не могу дать билет кому попало.",
      "choices": [
        {
          "id": "try_again",
          "text": "Погоди, я серьёзно! Мне это действительно нужно.",
