{
  "id": "twilight_library_card",
  "nodes": {
    "start": {
      "text": "Привет! Я Твайлайт Спаркл. Чем могу помочь?",
      "sound": "ponynpc:talk",
      "sound_chars": 2,
      "choices": [
        {
          "id": "ask_card",
          "text": "Мне нужен читательский билет для архива библиотеки.",
          "next": "card_question",
          "once": false,
          "conditions": ["quest:shadow_book_ch1:stage:find_twilight"],
          "hidden_if_condition_fails": true
        },
        {
          "id": "nothing",
          "text": "Просто хотел поздороваться.",
          "next": null,
          "once": false
        }
      ]
    },
    "card_question": {
      "text": "Читательский билет? Хм... Для чего именно тебе нужен архив?",
      "choices": [
        {
          "id": "truth",
          "text": "Я ищу старую книгу. Трикси сказала что она там.",
          "next": "card_trust",
          "once": false
