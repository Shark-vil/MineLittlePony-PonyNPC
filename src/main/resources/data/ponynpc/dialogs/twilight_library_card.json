          "once": false
        },
        {
          "id": "leave",
          "text": "Ладно, я вернусь позже.",
          "next": null,
          "once": false
        }
      ]
    },
    "card_trust": {
      "text": "Хорошо. Я вижу что ты честен. Держи — это мой запасной читательский билет. Обращайся с книгами аккуратно!",
      "choices": [
        {
          "id": "thanks",
          "text": "Спасибо огромное, Твайлайт!",
          "next": null,
          "once": false,
          "conditions": ["quest:shadow_book_ch1:stage:find_twilight"],
          "hidden_if_condition_fails": false,
          "actions": [
            "quest:shadow_book_ch1:give_quest_item:library_card",
            "quest:shadow_book_ch1:complete_stage"
          ]
        },
        {
          "id": "thanks_no_quest",
          "text": "Спасибо!",
          "next": null,
          "once": false,
          "conditions": ["quest:shadow_book_ch1:stage:find_twilight"],
          "hidden_if_condition_fails": true
        }
      ]
